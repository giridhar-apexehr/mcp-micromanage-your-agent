# Copy this file to .env and adjust values as needed.
#
# Notes:
# - Values shown here are examples. Most variables are optional in development.
# - In production, make sure to set strong secrets and restrict CORS appropriately.

# ------------------------------
# Server / HTTP
# ------------------------------
# Host/IP to bind the HTTP server to.
HTTP_HOST=127.0.0.1

# Port to bind the HTTP server to.
HTTP_PORT=8787

# CORS allowlist.
# - "true" (default) allows all origins
# - "false" disables CORS
# - otherwise, set to an origin string (e.g. https://your-ui.example)
CORS_ORIGIN=true

# Log level: DEBUG | INFO | WARN | ERROR | NONE
LOG_LEVEL=INFO

# Node environment.
NODE_ENV=development

# ------------------------------
# Database (Kysely)
# ------------------------------
# Which DB dialect to use.
# Supported: sqlite | postgres
DB_DIALECT=sqlite

# SQLite database file path (used when DB_DIALECT=sqlite).
DB_PATH=./data/app.sqlite

# Postgres connection URL (required when DB_DIALECT=postgres).
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ------------------------------
# Auth (Passport + openid-client)
# ------------------------------
# Enable multiple providers at once (comma-separated).
# Supported: oidc,google
AUTH_PROVIDERS=oidc,google

# (Alternative) single-provider mode.
# AUTH_PROVIDER=oidc

# Session secret for express-session.
# Required in production.
SESSION_SECRET=change-me-in-prod

# UI redirect target base URL.
# If unset, redirects will be relative to the server's own origin.
UI_BASE_URL=http://localhost:5173

# Where to redirect after successful login.
UI_AUTH_SUCCESS_PATH=/

# Where to redirect after login failure.
UI_AUTH_FAILURE_PATH=/login

# --- Generic/local OIDC provider (provider id: "oidc") ---
# OIDC issuer URL (discovery will be performed from this).
OIDC_ISSUER_URL=https://example-issuer.com

# OAuth client credentials.
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret

# Space-delimited scopes.
OIDC_SCOPE=openid email profile

# Callback URL registered with your IdP.
# If omitted, defaults to: http(s)://<server-host>/auth/oidc/callback
# OIDC_CALLBACK_URL=http://localhost:8787/auth/oidc/callback

# --- Google provider preset (provider id: "google") ---
# Google OAuth client credentials.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Space-delimited scopes.
GOOGLE_SCOPE=openid email profile

# Optional Google Workspace hosted domain restriction.
# If set, the login flow will include Google's `hd` authorization request parameter.
# GOOGLE_HOSTED_DOMAIN=example.com

# Callback URL registered with Google.
# If omitted, defaults to: http(s)://<server-host>/auth/google/callback
# GOOGLE_CALLBACK_URL=http://localhost:8787/auth/google/callback
